rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isParticipant(chatId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function chatExists(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId));
    }

    function isParticipantOrChatMissing(chatId) {
      return isSignedIn() &&
        (
          !chatExists(chatId) ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
    }

    function isParticipantInPendingChat(chatId) {
      return isSignedIn() &&
        request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wavesReceivedCount'])
      );
      allow delete: if false;

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }
    
    match /users/{uid}/memberships/{membershipId} {
      allow read, write: if isSignedIn() && (
        request.auth.uid == uid || 
        request.auth.uid in get(/databases/$(database)/documents/classes/$(membershipId)).data.writerUids
      );
    }
    
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        (request.auth.uid in resource.data.writerUids ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'memberUids']));
      allow delete: if isSignedIn() &&
        request.auth.uid == resource.data.creatorUid;
    }

    match /attendance_cache/{uid} {
      allow read, write: if isOwner(uid);
      match /records/{rollNumber} {
        allow read, write: if isOwner(uid);
      }
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.recipientId ||
        request.auth.uid == resource.data.uid ||
        request.auth.uid == resource.data.senderId
      );
      allow create: if isSignedIn() && (
        request.auth.uid == request.resource.data.senderId ||
        request.auth.uid == request.resource.data.uid
      );
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superuser';
    }

    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superuser';
    }

    match /sciwordle_daily/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /sciwordle_scores/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwner(docId);
    }

    match /sciwordle_progress/{docId} {
      allow read, write: if isOwner(docId);
    }

    match /community_deletions/{docId} {
      allow read, write: if isSignedIn();
    }

    match /chats/{chatId} {
      allow read: if isParticipantOrChatMissing(chatId);
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;
      allow update: if isParticipant(chatId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipantOrChatMissing(chatId);
        allow create: if request.auth != null &&
          request.resource.data.senderId == request.auth.uid &&
          (
            isParticipant(chatId) ||
            isParticipantInPendingChat(chatId)
          );
        allow update: if isParticipant(chatId);
        allow delete: if false;
      }
    }

    // ── Links / Follows ──────────────────────────────────────────────────
    match /follows/{followId} {
      // Anyone signed in can read to determine link status
      allow read: if isSignedIn();

      // Only the sender can create a link request
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.followerId;

      // Only the receiver (the target) can accept (update status to 'accepted')
      // The sender can update to cancel
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.followingId ||
        request.auth.uid == resource.data.followerId
      );

      // Both users can delete (unlink / cancel / decline)
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.followerId ||
        request.auth.uid == resource.data.followingId
      );
    }

    match /{collectionName}/{docId} {
      allow read: if collectionName == 'universities' || collectionName == 'universities ' || collectionName == 'Universities' || collectionName == 'Universities ';
      allow write: if (collectionName == 'universities' || collectionName == 'universities ' || collectionName == 'Universities' || collectionName == 'Universities ') && isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superuser';
    }

    match /{path=**}/{collectionName}/{docId} {
      allow read: if collectionName == 'universities' || collectionName == 'universities ' || collectionName == 'Universities' || collectionName == 'Universities ';
      allow write: if (collectionName == 'universities' || collectionName == 'universities ' || collectionName == 'Universities' || collectionName == 'Universities ') && isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superuser';
    }

    match /uni_chats/{universityId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (
          request.auth.uid == request.resource.data.senderId ||
          request.resource.data.senderId == 'luna_ai' ||
          request.resource.data.isLuna == true
        );
        allow update: if isSignedIn();
        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }

    // ── University Docs ───────────────────────────────────────────────────
    match /university_docs/{docId} {
      // Any signed-in user can read, add, edit, or delete docs
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ── Assignments ───────────────────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == resource.data.teacherId);
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.teacherId);
    }

    // ── Campus Spark Votes ────────────────────────────────────────────────
    match /campus_spark_votes/{voteId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.uid;
    }

    // ── Waves ─────────────────────────────────────────────────────────────
    match /waves/{waveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId
      );
    }

    // ── Projects Showcase ─────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedByUserIds'])
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
    }
  }
}

